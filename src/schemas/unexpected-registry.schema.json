{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/unexpected-registry.schema.json",
  "title": "Unexpected Response Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_language", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "default_language": { "$ref": "#/$defs/language" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "language": { "enum": ["es", "ca"] },
    "text80": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 80 },
        { "type": "object", "additionalProperties": false, "required": ["es", "ca"], "properties": { "es": { "type": "string", "minLength": 1, "maxLength": 80 }, "ca": { "type": "string", "minLength": 1, "maxLength": 80 } } }
      ]
    },
    "text120": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 120 },
        { "type": "object", "additionalProperties": false, "required": ["es", "ca"], "properties": { "es": { "type": "string", "minLength": 1, "maxLength": 120 }, "ca": { "type": "string", "minLength": 1, "maxLength": 120 } } }
      ]
    },
    "text1200": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 1200 },
        { "type": "object", "additionalProperties": false, "required": ["es", "ca"], "properties": { "es": { "type": "string", "minLength": 1, "maxLength": 1200 }, "ca": { "type": "string", "minLength": 1, "maxLength": 1200 } } }
      ]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "tone": { "enum": ["neutral", "advance", "clarify", "objection", "handoff", "close"] },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "next": {
          "type": "string",
          "pattern": "^(@return|@end:[A-Za-z0-9][A-Za-z0-9._-]{0,99}|[A-Za-z0-9][A-Za-z0-9._-]{0,99})$"
        },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "keywords", "behavior", "say", "responses"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "category": { "$ref": "#/$defs/text80" },
        "keywords": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "behavior": { "enum": ["return", "branch", "end"] },
        "tone": { "$ref": "#/$defs/tone" },
        "say": { "$ref": "#/$defs/text1200" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/response" }
        }
      }
    }
  }
}
