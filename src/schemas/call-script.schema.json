{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/call-script.schema.json",
  "title": "Call Tree Player Script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "script_id", "title", "company", "start_node", "outcomes", "nodes"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "script_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "company": { "$ref": "#/$defs/company" },
    "start_node": { "$ref": "#/$defs/id" },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "unexpected_routes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contact_name": { "type": "string", "maxLength": 120 },
        "contact_role": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 80 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "tone": {
      "enum": ["neutral", "advance", "clarify", "objection", "handoff", "close"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "text": { "type": "string", "maxLength": 3000 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "image_url": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "next": { "$ref": "#/$defs/id" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": { "outcome": { "$ref": "#/$defs/id" } }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "say", "responses"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "say": { "type": "string", "minLength": 1, "maxLength": 1200 },
            "evidence": {
              "type": "array",
              "maxItems": 5,
              "items": { "$ref": "#/$defs/evidence" }
            },
            "responses": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/response" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "say", "terminal"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "say": { "type": "string", "minLength": 1, "maxLength": 1200 },
            "evidence": {
              "type": "array",
              "maxItems": 5,
              "items": { "$ref": "#/$defs/evidence" }
            },
            "terminal": { "$ref": "#/$defs/terminal" }
          }
        }
      ]
    }
  }
}
