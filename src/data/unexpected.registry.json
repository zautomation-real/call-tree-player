{
  "schema_version": "1.0.0",
  "default_language": "es",
  "entries": [
    {
      "id": "how_got_number",
      "label": { "es": "¿Cómo has conseguido mi número?", "ca": "Com has aconseguit el meu número?" },
      "category": { "es": "Dudas", "ca": "Dubtes" },
      "keywords": ["número", "contacto", "datos", "contacte", "dades"],
      "behavior": "return",
      "tone": "clarify",
      "say": {
        "es": "He utilizado el teléfono profesional publicado por la empresa. Si prefieres que no vuelva a utilizarlo, lo dejo registrado.",
        "ca": "He utilitzat el telèfon professional publicat per l'empresa. Si prefereixes que no el torni a utilitzar, ho deixo registrat."
      },
      "responses": [
        { "id": "continue", "label": { "es": "Continuar conversación", "ca": "Continuar la conversa" }, "next": "@return", "tone": "neutral" }
      ]
    },
    {
      "id": "wrong_person",
      "label": { "es": "No soy la persona adecuada", "ca": "No soc la persona adequada" },
      "category": { "es": "Contacto", "ca": "Contacte" },
      "keywords": ["persona", "responsable", "web", "adequada"],
      "behavior": "branch",
      "tone": "handoff",
      "say": {
        "es": "Gracias. ¿Quién sería la persona adecuada para hablar de la web?",
        "ca": "Gràcies. Qui seria la persona adequada per parlar del web?"
      },
      "responses": [
        { "id": "name", "label": { "es": "Te digo su nombre", "ca": "Et dic el seu nom" }, "next": "@return", "tone": "handoff" },
        { "id": "unknown", "label": { "es": "No lo sé", "ca": "No ho sé" }, "next": "@return", "tone": "neutral" }
      ]
    },
    {
      "id": "what_do_you_want",
      "label": { "es": "¿Dónde quieres llegar?", "ca": "On vols arribar?" },
      "category": { "es": "Intención", "ca": "Intenció" },
      "keywords": ["qué quieres", "dónde quieres llegar", "objetivo", "què vols", "on vols arribar", "objectiu"],
      "behavior": "return",
      "tone": "clarify",
      "say": {
        "es": "Quiero confirmar si lo que he encontrado ya está localizado y quién puede gestionarlo. Si no os aporta nada, lo dejamos aquí.",
        "ca": "Vull confirmar si el que he trobat ja està localitzat i qui ho pot gestionar. Si no us aporta res, ho deixem aquí."
      },
      "responses": [
        { "id": "continue", "label": { "es": "Continuar conversación", "ca": "Continuar la conversa" }, "next": "@return", "tone": "neutral" }
      ]
    },
    {
      "id": "do_not_contact",
      "label": { "es": "No vuelvas a contactar", "ca": "No tornis a contactar" },
      "category": { "es": "Cierre", "ca": "Tancament" },
      "keywords": ["no contactar", "borrar", "no llamar", "no trucar", "esborrar"],
      "behavior": "end",
      "tone": "close",
      "say": {
        "es": "Entendido. Lo dejo registrado y no volveré a contactar. Gracias.",
        "ca": "Entesos. Ho deixo registrat i no tornaré a contactar. Gràcies."
      },
      "responses": [
        { "id": "finish", "label": { "es": "Finalizar llamada", "ca": "Finalitzar la trucada" }, "next": "@end:do_not_contact", "tone": "close" }
      ]
    }
  ]
}
